---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import type { Exercise } from "@/types";
import ExerciseFlow from "@/components/exercise/ExerciseFlow";
import type { UserIntroView } from "@/types";

export const prerender = false;

const { user } = Astro.locals;
if (!user) {
  return Astro.redirect("/auth/signin?error=Unauthorized");
}

const { id } = Astro.params;

if (!id || !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test(id)) {
  return Astro.redirect("/dashboard?error=Invalid+exercise+ID");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  return Astro.redirect("/dashboard?error=Server+configuration+error");
}

const result = await supabase.from("exercises").select("*").eq("id", id).single();

// Handle not found
if (result.error || !result.data) {
  return Astro.redirect("/dashboard?error=Exercise+not+found");
}

const exercise = result.data as Exercise;

const introResult = await supabase.from("user_intro_views").select("exercise_type").eq("user_id", user.id);

const seenIntros: string[] = introResult.error
  ? []
  : (introResult.data as Pick<UserIntroView, "exercise_type">[]).map((r) => r.exercise_type);
---

<Layout title={exercise.title}>
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-4xl">
      <div class="mb-4">
        <a
          href="/dashboard"
          class="inline-flex items-center gap-1 text-sm text-blue-100/60 transition-colors hover:text-blue-100"
        >
          ← Back to Dashboard
        </a>
      </div>
      <ExerciseFlow exercise={exercise} seenIntros={seenIntros} client:load />
    </div>
  </div>
</Layout>
