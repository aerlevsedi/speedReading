---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { Button } from "@/components/ui/button";
import { Progress } from "@/components/ui/progress";
import type { Completion, Exercise } from "@/types";
import { CheckCircle2, XCircle, Clock, Zap } from "lucide-react";

export const prerender = false;

const { id } = Astro.params;
const { user } = Astro.locals;

if (!id) {
  return Astro.redirect("/dashboard?error=Invalid+completion+ID");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  return Astro.redirect("/dashboard?error=Server+configuration+error");
}

if (!user) {
  return Astro.redirect("/auth/signin?error=Authentication+required");
}

const result = await supabase
  .from("exercise_completions")
  .select("*, exercises(*)")
  .eq("id", id)
  .eq("user_id", user.id)
  .single();

if (result.error || !result.data) {
  return Astro.redirect("/dashboard?error=Completion+not+found");
}

const completion = result.data as Completion & { exercises: Exercise };
const exercise = completion.exercises;
const wpm = completion.type_data.wpm ?? 0;

// Map exercise type to question count
// Note: smart_questions removed 2026-06-08, kept here for backward compatibility with old completions
const questionCountByType: Record<string, number> = {
  animated_pacer: 2,
  smart_questions: 5, // Removed type, but may have old completion records
  focus_sprint: 3, // Read at own pace + comprehension quiz
  speed_scan: 3,
};
const totalQuestions = questionCountByType[exercise.exercise_type] ?? 0;
const correctAnswers = totalQuestions - completion.errors;

// WPM is shown for all reading exercises (all types read text)
const showWpm = exercise.exercise_type === "animated_pacer" || exercise.exercise_type === "focus_sprint";

// Goal comparison: only for Focus Sprint (user-paced, true WPM baseline)
const showGoalComparison = exercise.exercise_type === "focus_sprint";
let targetWpm: number | null = null;
if (showGoalComparison) {
  const goalResult = await supabase.from("user_goals").select("target_wpm").eq("user_id", user.id).maybeSingle();
  // eslint-disable-next-line @typescript-eslint/no-unsafe-assignment
  targetWpm = goalResult.data?.target_wpm ?? null;
}
const goalPct = targetWpm && wpm > 0 ? Math.min(Math.round((wpm / targetWpm) * 100), 100) : null;
const goalReached = targetWpm !== null && wpm >= targetWpm;

// Format duration as MM:SS
const minutes = Math.floor(completion.duration_seconds / 60);
const seconds = completion.duration_seconds % 60;
const formattedDuration = `${minutes}:${seconds.toString().padStart(2, "0")}`;
---

<Layout title="Results">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-3xl">
      <div class="mb-8 text-center">
        <h1 class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-4xl font-bold text-transparent">
          Exercise Complete!
        </h1>
        <p class="text-blue-100/60">{exercise.title}</p>
      </div>

      <!-- Metrics Grid -->
      <div class:list={["mb-8 grid gap-4", showWpm ? "sm:grid-cols-3" : "sm:grid-cols-2"]}>
        <!-- Duration -->
        <div class="rounded-2xl border border-white/10 bg-white/10 p-6 text-center backdrop-blur-xl">
          <Clock class="mx-auto mb-2 size-8 text-blue-300" />
          <div class="mb-1 text-3xl font-bold text-white">{formattedDuration}</div>
          <div class="text-xs text-blue-100/60">Duration</div>
        </div>

        <!-- WPM (only for reading exercises) -->
        {
          showWpm && (
            <div class="rounded-2xl border border-white/10 bg-white/10 p-6 text-center backdrop-blur-xl">
              <Zap class="mx-auto mb-2 size-8 text-purple-300" />
              <div class="mb-1 text-3xl font-bold text-white">{wpm} WPM</div>
              <div class="text-xs text-blue-100/60">Reading Speed</div>
            </div>
          )
        }

        <!-- Comprehension (only if exercise has questions) -->
        {
          totalQuestions > 0 && (
            <div class="rounded-2xl border border-white/10 bg-white/10 p-6 text-center backdrop-blur-xl">
              {completion.errors === 0 ? (
                <CheckCircle2 class="mx-auto mb-2 size-8 text-green-300" />
              ) : (
                <XCircle class="mx-auto mb-2 size-8 text-orange-300" />
              )}
              <div class="mb-1 text-3xl font-bold text-white">
                {correctAnswers}/{totalQuestions}
              </div>
              <div class="text-xs text-blue-100/60">Correct Answers</div>
            </div>
          )
        }
      </div>

      <!-- Goal Comparison (Focus Sprint only) -->
      {
        showGoalComparison && (
          <div class="mb-8 rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
            <h2 class="mb-4 text-sm font-semibold tracking-wide text-blue-100/60 uppercase">Reading Speed Goal</h2>
            {targetWpm !== null && goalPct !== null ? (
              <div>
                <div class="mb-3 flex items-baseline justify-between">
                  <span class="text-lg font-bold text-white">
                    {wpm} wpm / {targetWpm} wpm
                  </span>
                  <span class:list={["text-sm font-semibold", goalReached ? "text-green-300" : "text-blue-200"]}>
                    {goalReached ? "Goal reached! 🎉" : `${goalPct}%`}
                  </span>
                </div>
                <Progress value={goalPct} className="h-3" client:load />
              </div>
            ) : (
              <p class="text-sm text-blue-100/60">
                No goal set yet.{" "}
                <a href="/dashboard" class="text-blue-300 underline underline-offset-2 hover:text-blue-200">
                  Set your reading speed goal
                </a>{" "}
                to track your progress.
              </p>
            )}
          </div>
        )
      }

      <!-- Navigation -->
      <div class="text-center">
        <a href="/dashboard">
          <Button size="lg" client:load>Back to Dashboard</Button>
        </a>
      </div>
    </div>
  </div>
</Layout>
